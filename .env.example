# Copy to .env (gitignored). The assistant works without any of this: with no provider
# the interface answers from the table itself and labels the answer "computed from the table".

# openai-compatible | azure | none
LLM_PROVIDER=none

# --- openai-compatible: OpenAI, Gemini's OpenAI endpoint, OpenRouter, Ollama, Azure Foundry v1 ...
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1                                   LLM_MODEL=gpt-4.1-mini
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai      LLM_MODEL=gemini-2.5-flash
# Ollama:      LLM_BASE_URL=http://127.0.0.1:11434/v1                                   LLM_MODEL=llama3.1   LLM_API_KEY=ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# --- azure: classic Azure OpenAI deployment endpoint
# Same resource as the DIU Ai Assistant project (OPENAI_ENDPOINT / OPENAI_KEY / DEPLOYMENT_NAME).
# GPT-5.4 is a limited-access model; the subscription must be approved first (aka.ms/OAI/gpt54access).
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# LLM_REASONING_EFFORT=low

# Set to 1 during the demo rehearsal: the server answers only from cache and fixtures.
OFFLINE=0
# PORT=8787
